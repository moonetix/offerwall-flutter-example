# Copy to .env and fill in. Never commit .env. Server only: nothing here goes into the app.

# Moonetix dashboard: API page. Creates offerwall sessions.
MOONETIX_API_KEY=your-api-key
# Moonetix dashboard: Postback page. Checks the postback hash.
MOONETIX_POSTBACK_KEY=your-postback-secret-key

# Optional
PORT=3000
# 127.0.0.1 is enough for the Android emulator and the iOS Simulator.
# Use 0.0.0.0 to reach the server from a phone on the same network.
HOST=127.0.0.1
DATABASE_PATH=./data.sqlite
CURRENCY_NAME=Coins
SESSION_DAYS=30
